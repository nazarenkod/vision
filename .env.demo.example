# Copy to .env.demo and adjust. Used by scripts/vision.sh and scripts/demo-clone-from-prod.sh.
# Never put production's own ports, database or folders in the DEMO_* / POSTGRES_* lines.

## Demo instance
DEMO_UI_PORT=18080
DEMO_API_PORT=14200
# URLs as the browser sees them (replace localhost with the host name for remote access)
DEMO_UI_URL=http://localhost:18080
DEMO_API_URL=http://localhost:14200

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vision

# Signs sessions: a new random string (openssl rand -base64 32), not the secret of the working VRT.
# The API does not start with this example, a value under 32 characters or the same value as below.
JWT_SECRET=change-me
# Seals Jira tokens and Gemini keys in the database: a long random string, kept for good;
# a new one makes people enter their tokens again (openssl rand -base64 32); as strict as JWT_SECRET
VISION_SECRET_KEY=change-me
# Jira hosts a personal token may go to, comma-separated; empty: Vision calls no Jira.
# A host name means https on the standard port; another port or http: https://jira.example.com:8443
VISION_JIRA_HOSTS=jira.example.com
# The API documentation at <API>/api: off unless true
VISION_SWAGGER=false

## Corporate sign-in beside local accounts (DEPLOY.md §6): LDAP or SSO, one of them
#LDAP_ENABLED=true
#LDAP_URL=ldaps://ldap.example.com:636/
#LDAP_BIND_USER=CN=searchuser,OU=systemaccounts,DC=example,DC=com
#LDAP_BIND_PASSWORD=
#LDAP_SEARCH_DN=OU=users,DC=example,DC=com
#LDAP_USERS_SEARCH_FILTER=(&(objectClass=Person)(|(mail={{email}})(sAMAccountName={{email}})))
#OIDC_ENABLED=true
#OIDC_ISSUER_URL=https://idp.example.com/realms/example
#OIDC_CLIENT_ID=vision
#OIDC_CLIENT_SECRET=
#OIDC_ADMIN_VALUES=vision-admin
BODY_PARSER_JSON_LIMIT=20mb
# screenshots: file size in MB and width × height in pixels the API takes
VISION_MAX_SCREENSHOT_MB=50
VISION_MAX_SCREENSHOT_PIXELS=40000000

## A closed network (DEPLOY.md §1): leave empty where the public internet is reachable
# CA of a proxy that re-signs TLS (PEM file): trusted when building and by the API (Jira, Gemini)
VISION_EXTRA_CA_FILE=
# a mirror of registry.npmjs.org, e.g. https://nexus.bank/repository/npm/
VISION_NPM_REGISTRY=
# a mirror of binaries.prisma.sh (the migration engine is downloaded while building)
VISION_PRISMA_ENGINES_MIRROR=

## Limits, so Vision cannot starve production on the same host
DEMO_API_CPUS=2
DEMO_API_MEMORY=3g
DEMO_DIFF_WORKERS=2
DEMO_POSTGRES_CPUS=1
DEMO_POSTGRES_MEMORY=1g
DEMO_UI_CPUS=0.5
DEMO_UI_MEMORY=256m
# Disk that must stay free for production when copying and building (GB).
# Empty: 10 GB or 5 % of the disk, whichever is more.
VISION_DISK_RESERVE_GB=

## AI: gemini | ollama | none
AI_PROVIDER=none
# e.g. a Flash-Lite Gemini model, or gemma3:4b for Ollama
AI_MODEL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_DAILY_CALL_LIMIT=500

## Source: the running production VRT (read-only use)
# Either the name of its Postgres container on this host...
PROD_PG_CONTAINER=
# ...or a connection string reachable from this host
PROD_DATABASE_URL=
# With PROD_PG_CONTAINER: VRT's database name, when it is not the container's POSTGRES_DB
# (see DATABASE_URL of the production API). Empty: POSTGRES_DB. The whole database is
# copied: every project, build, baseline, user and API key.
PROD_DB_NAME=
# Folder the production API stores images in (its ./imageUploads)
PROD_IMAGES_DIR=
# copy: a full copy (needs the space, checked first); link: hard links, no extra space,
# needs ./demo-data on the same disk. Both leave production's files untouched.
PROD_IMAGES_MODE=copy

## Backups (scripts/vision-backup.sh, scripts/vision-restore.sh; DEPLOY.md, backups)
# rclone remote and folder, e.g. gdrive:vision-backups. Empty: local backups only, no warnings.
# rclone runs from its Docker image when it is not installed; its config folder:
RCLONE_CONFIG_DIR=
BACKUP_REMOTE=
# How many daily database backups to keep on the remote
BACKUP_KEEP=7
# Backups hold no passwords: after a restore you sign in with these, and this user
# becomes an admin. Keep a copy outside this machine. At least 12 characters.
VISION_MASTER_EMAIL=
VISION_MASTER_PASSWORD=
