# Copy to .env.demo and adjust. Used by docker-compose.demo.yml and scripts/demo-clone-from-prod.sh.

## Demo instance
DEMO_UI_PORT=18080
DEMO_API_PORT=14200
DEMO_POSTGRES_PORT=15432
# URLs as the browser sees them (replace localhost with the host name for remote access)
DEMO_UI_URL=http://localhost:18080
DEMO_API_URL=http://localhost:14200

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vrt_demo

# Use the same secret as production if you want existing API keys/sessions to behave the same
JWT_SECRET=change-me
BODY_PARSER_JSON_LIMIT=20mb

## AI: gemini | ollama | none
AI_PROVIDER=none
# e.g. a Flash-Lite Gemini model, or gemma3:4b for Ollama
AI_MODEL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_DAILY_CALL_LIMIT=500

## Source: the running production VRT (read-only use)
# Either the name of its Postgres container on this host...
PROD_PG_CONTAINER=
# ...or a connection string reachable from this host
PROD_DATABASE_URL=
# Folder the production API stores images in (its ./imageUploads)
PROD_IMAGES_DIR=
