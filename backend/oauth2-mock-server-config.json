{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "admin",
          "claims": {
            "email": "admin@oidcmock.local",
            "email_verified": true,
            "given_name": "Ada",
            "family_name": "Admin",
            "groups": ["vision-admin"]
          }
        },
        {
          "requestParam": "subject",
          "match": ".*",
          "claims": {
            "email": "editor@oidcmock.local",
            "email_verified": true,
            "given_name": "Ed",
            "family_name": "Editor",
            "groups": ["vision-editor"]
          }
        }
      ]
    }
  ]
}
