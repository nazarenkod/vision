{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // See: https://github.com/prisma/prisma/issues/10203
    "strictNullChecks": true,
    // TypeScript 6 turned strict on and types off by default; the seed was written for the old ones
    "strict": false,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules"]
}
