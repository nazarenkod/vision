exports[`15 the MCP server lists and runs its tools 1`] = `
{
  "code": 0,
  "err": "",
  "replies": [
    {
      "id": 1,
      "jsonrpc": "2.0",
      "result": {
        "capabilities": {
          "tools": {},
        },
        "protocolVersion": "2024-11-05",
        "serverInfo": {
          "name": "vision",
          "version": "1.0.0",
        },
      },
    },
    {
      "id": 2,
      "jsonrpc": "2.0",
      "result": {
        "tools": [
          {
            "description": "Take the screen currently shown on the test device (adb, Appium or iOS simulator) or given files, send it to Vision as a named check and return what Vision found: status against the baseline, changed elements, hidden changes, accessibility issues and a review link.",
            "inputSchema": {
              "properties": {
                "appium": {
                  "description": "Appium server URL, to take the screen from its session",
                  "type": "string",
                },
                "branch": {
                  "description": "Branch to check against (default: manual)",
                  "type": "string",
                },
                "name": {
                  "description": "Check name, e.g. 'Payment' or 'Payment – error state'",
                  "type": "string",
                },
                "png": {
                  "description": "Path to a screenshot instead of a device",
                  "type": "string",
                },
                "serial": {
                  "description": "adb device serial when several are connected",
                  "type": "string",
                },
                "simulator": {
                  "description": "Take a screenshot of the booted iOS simulator",
                  "type": "boolean",
                },
                "tags": {
                  "description": "Custom tags, e.g. 'dark'",
                  "type": "string",
                },
                "xml": {
                  "description": "Path to the UI tree XML going with png",
                  "type": "string",
                },
              },
              "required": [
                "name",
              ],
              "type": "object",
            },
            "name": "vision_check",
          },
          {
            "description": "List Android devices connected over adb.",
            "inputSchema": {
              "properties": {},
              "type": "object",
            },
            "name": "vision_devices",
          },
          {
            "description": "Start or finish a session: checks sent while it is open go to one build.",
            "inputSchema": {
              "properties": {
                "action": {
                  "enum": [
                    "start",
                    "finish",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "action",
              ],
              "type": "object",
            },
            "name": "vision_session",
          },
        ],
      },
    },
    {
      "id": 3,
      "jsonrpc": "2.0",
      "result": {
        "content": [
          {
            "text": "MCP payment
Status: new: no baseline yet; approve it in Vision to make it the baseline
Accessibility: 7 new, 9 total
  NEW Control has no label: ImageButton (id/btn_scan_qr) has nothing for TalkBack to read out.
  NEW Touch target too small: ImageButton "Help" (id/btn_help) is 36 × 36 dp, minimum is 48 × 48 dp. [QA-1]
  NEW Low text contrast: TextView "Payment" (id/toolbar_title): 3.0 : 1, needs 4.5 : 1. [QA-100]
  NEW Touch target too small: ImageButton (id/btn_scan_qr) is 34 × 34 dp, minimum is 48 × 48 dp.
  NEW Input has no label or hint: EditText (id/et_amount) gives no clue what to enter.
  NEW Low text contrast: TextView "Commission 0 UAH" (id/tv_fee): 2.9 : 1, needs 4.5 : 1.
  NEW Same label on several controls: 2 controls are announced as "next"; users cannot tell them apart.
  NEW Same label on several controls: 2 controls are announced as "next"; users cannot tell them apart.
  NEW Low text contrast: Button "Pay" (id/btn_pay): 1.8 : 1, needs 3 : 1.
  NEW Label repeats the role: "Close button" already gets its role announced; drop words like "button" or "image".
Review: http://vision.control.test/<id4>?buildId=<id26>&testId=<id27>",
            "type": "text",
          },
        ],
        "isError": false,
      },
    },
  ],
}
`;

