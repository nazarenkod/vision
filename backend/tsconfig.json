{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // TypeScript 6 turned these on or narrowed them by default; the code was written for the old ones
    "strict": false,
    "types": ["node", "jest", "multer"]
  },
  "exclude": ["node_modules", "dist"]
}
